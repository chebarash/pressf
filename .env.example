# Postgres. Railway sets this when you add the Postgres service.
# Leave empty locally to browse the site on sample data.
DATABASE_URL=

# Public address of the site
NEXTAUTH_URL=https://pressf.chebarash.uz
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth client. Redirect URI: https://pressf.chebarash.uz/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma separated emails with access to /admin
ADMIN_EMAILS=

# anonymous bot API, see docs/BOT_API_REQUEST.md
BOT_API_URL=
BOT_API_TOKEN=

# Protects /api/cron/sync. openssl rand -hex 32
CRON_SECRET=

# S3-compatible storage for course files and faces
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Files bot
TELEGRAM_FILES_BOT_TOKEN=
TELEGRAM_FILES_WEBHOOK_SECRET=
TELEGRAM_FILES_REVIEW_CHAT_ID=

# Reads course details from syllabi
ANTHROPIC_API_KEY=

# Turn on once the bot's /api/mentions/export stops blocking it: MENTIONS_SYNC=on
MENTIONS_SYNC=
# Local only: signs every request in as this email
DEV_LOGIN_EMAIL=
