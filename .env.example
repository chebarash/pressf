# Postgres. Railway sets this when you add the Postgres service.
DATABASE_URL=

# Public address of the site
NEXTAUTH_URL=https://pressf.chebarash.uz
# Signs the session cookie. openssl rand -base64 32
NEXTAUTH_SECRET=

# Comma separated emails with access to /admin
ADMIN_EMAILS=

# Seals stored LMS passwords (AES-256-GCM). openssl rand -base64 32. Never rotate without re-sign-in.
CREDENTIAL_KEY=
# NewUU LMS API; the client defaults to the live one
LMS_API_URL=

# Protects /api/cron/*. openssl rand -hex 32
CRON_SECRET=

# S3-compatible storage for files and faces
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The Press F Telegram bot and Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Anonymous channel bot API, for posts that mention courses and professors (docs/BOT_API_REQUEST.md)
BOT_API_URL=
BOT_API_TOKEN=
# Turn on once the bot's /api/mentions/export stops blocking it: MENTIONS_SYNC=on
MENTIONS_SYNC=

# Reads course details from syllabi found in LMS files
ANTHROPIC_API_KEY=

# Local only: signs every request in as this email
DEV_LOGIN_EMAIL=
